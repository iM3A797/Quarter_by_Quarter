{
 "hosting": {
  "public": "public",
  "ignore": [
   "firebase.json",
   "**/.*"
  ],
  "cleanUrls": true,
  "rewrites": [
   {
    "source": "**",
    "destination": "/index.html"
   }
  ],
  "headers": [
   {
    "source": "**",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     },
     {
      "key": "X-Content-Type-Options",
      "value": "nosniff"
     },
     {
      "key": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
     },
     {
      "key": "X-Frame-Options",
      "value": "SAMEORIGIN"
     },
     {
      "key": "Cross-Origin-Opener-Policy",
      "value": "same-origin-allow-popups"
     }
    ]
   },
   {
    "source": "/icons/**",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public,max-age=604800"
     }
    ]
   },
   {
    "source": "/fonts/**",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public,max-age=604800"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 }
}
