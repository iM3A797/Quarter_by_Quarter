rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each person can only read and write their own progress document
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 't', 'dev'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.t is number;
    }
  }
}
